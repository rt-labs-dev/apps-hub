---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import RtClipPreview from "../../components/RtClipPreview.astro";
import DownloadButtons from "../../components/DownloadButtons.astro";
import { apps, indexNumber, PLATFORM_NAMES, type App } from "../../data/apps";

export const getStaticPaths = (() => apps.map((app) => ({ params: { slug: app.slug }, props: { app } }))) satisfies GetStaticPaths;

const { app } = Astro.props as { app: App };

const previews: Record<string, typeof RtClipPreview> = { "rt-clip": RtClipPreview };
const Preview = previews[app.slug];

const specs = [
  { label: "Platforms", value: app.platforms.map((platform) => PLATFORM_NAMES[platform]).join(", ") },
  ...app.platforms.map((platform) => ({ label: `${PLATFORM_NAMES[platform]} needs`, value: app.requirements[platform] })),
  ...app.specs,
];
---

<Base title={app.name} description={app.tagline}>
  <nav class="flex gap-2 pt-8 font-mono text-[11px] text-neutral-500">
    <a href="/" class="hover:text-cyan-300">Index</a>
    <span>/</span>
    <span>{indexNumber(app)}</span>
    <span>/</span>
    <span class="text-neutral-300">{app.name}</span>
  </nav>

  <section class="grid gap-14 py-12 lg:grid-cols-[1fr_360px] lg:items-center lg:py-16">
    <div>
      <div class="flex items-center gap-4">
        <img src={app.icon} alt="" width="64" height="64" class="size-16 rounded-2xl" />
        <span class="font-mono text-xs tracking-widest text-cyan-400 uppercase">{app.kind}</span>
      </div>
      <h1 class="mt-6 text-5xl font-semibold tracking-tight text-neutral-50 sm:text-6xl">{app.name}</h1>
      <p class="mt-4 max-w-xl text-xl text-neutral-200">{app.tagline}</p>
      <p class="mt-4 max-w-xl text-neutral-400">{app.description}</p>
      <div class="mt-10">
        <DownloadButtons app={app} />
      </div>
    </div>
    {Preview && <div class="flex justify-center lg:justify-end"><Preview /></div>}
  </section>

  <section class="grid gap-x-16 gap-y-12 border-t border-line py-16 lg:grid-cols-[1fr_22rem]">
    <div>
      <h2 class="font-mono text-xs tracking-widest text-neutral-500 uppercase">What it does</h2>
      <ol class="mt-6 grid gap-x-10 sm:grid-cols-2">
        {
          app.features.map((feature, index) => (
            <li class="flex gap-4 border-t border-line py-5">
              <span class="font-mono text-xs text-cyan-400">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3 class="font-medium text-neutral-100">{feature.title}</h3>
                <p class="mt-1.5 text-sm text-neutral-400">{feature.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
    <aside>
      <h2 class="font-mono text-xs tracking-widest text-neutral-500 uppercase">Spec sheet</h2>
      <dl class="mt-6 border-t border-line text-sm">
        {
          specs.map((spec) => (
            <div class="grid grid-cols-[7.5rem_1fr] gap-3 border-b border-line py-2.5">
              <dt class="font-mono text-[11px] text-neutral-500">{spec.label}</dt>
              <dd class="text-neutral-300">{spec.value}</dd>
            </div>
          ))
        }
      </dl>
      <div class="mt-8 space-y-3 border-l-2 border-cyan-400/60 pl-4 text-sm text-neutral-400">
        {app.notes.map((note) => <p>{note}</p>)}
      </div>
    </aside>
  </section>

  <section class="flex flex-wrap gap-x-8 gap-y-2 border-t border-line py-6 font-mono text-xs">
    <a href={`/${app.slug}/privacy/`} class="text-neutral-400 hover:text-cyan-300">Privacy policy</a>
    <a href={`https://github.com/${app.releasesRepo}/issues`} class="text-neutral-400 hover:text-cyan-300">Report a problem</a>
    <a href={`https://github.com/${app.releasesRepo}/releases`} class="text-neutral-400 hover:text-cyan-300">All releases</a>
  </section>
</Base>
