---
import {
  ArrowDownToLine,
  ArrowUpFromLine,
  CircleCheck,
  Cloud,
  History,
  LayoutDashboard,
  ListTree,
  Monitor,
  Play,
  RefreshCw,
  Settings,
} from "lucide-static";
import { icon } from "../lib/icons";

type Flavor = {
  name: string;
  hint: string;
  badge: { label: string; glyph: string; classes: string };
  local: [string, string];
  cloud: [string, string];
  pullHighlighted: boolean;
};

const flavors: Flavor[] = [
  {
    name: "Retail",
    hint: "This PC matches the latest cloud snapshot.",
    badge: { label: "In sync", glyph: CircleCheck, classes: "border-emerald-500/30 bg-emerald-500/10 text-emerald-300" },
    local: ["1,284 files, 18.6 MB", "Changed 2 hours ago"],
    cloud: ["From DESKTOP", "Pushed 2 hours ago"],
    pullHighlighted: false,
  },
  {
    name: "Classic",
    hint: "LAPTOP pushed newer settings. Pull before you play.",
    badge: { label: "Cloud is newer", glyph: ArrowDownToLine, classes: "border-cyan-500/30 bg-cyan-500/10 text-cyan-300" },
    local: ["642 files, 7.9 MB", "Changed 3 days ago"],
    cloud: ["From LAPTOP", "Pushed 20 minutes ago"],
    pullHighlighted: true,
  },
];

const activity = [
  { glyph: ArrowDownToLine, message: "Pulled Classic settings from LAPTOP", flavor: "Classic", time: "20 minutes ago" },
  { glyph: ArrowUpFromLine, message: "Pushed Retail settings", flavor: "Retail", time: "2 hours ago" },
  { glyph: Play, message: "Launched Retail", flavor: "Retail", time: "2 hours ago" },
];

const nav = [
  { label: "Dashboard", glyph: LayoutDashboard, active: true },
  { label: "Snapshots", glyph: History, active: false },
  { label: "Settings", glyph: Settings, active: false },
];

const button = "inline-flex h-8 items-center gap-1.5 rounded-lg px-3 text-[13px] font-medium";
---

<figure
  class="w-full overflow-hidden rounded-xl border border-cyan-400/25 bg-[#0c0d12] text-[#e8eaf0] shadow-[0_30px_80px_-20px_rgb(34_211_238/0.22)] [font-family:'Segoe_UI',system-ui,sans-serif]"
  aria-label="The rt-wow-sync dashboard, showing two game flavors with sample data"
>
  <div class="flex">
    <aside class="hidden w-48 shrink-0 flex-col border-r border-[#262a37] bg-[#14161d]/60 md:flex">
      <div class="flex items-center gap-2.5 px-4 py-4">
        <img src="/apps/rt-wow-sync/icon.png" alt="" class="size-7" />
        <span class="text-sm font-semibold tracking-tight">rt-wow-sync</span>
      </div>
      <nav class="flex flex-col gap-1 px-2.5">
        {
          nav.map((item) => (
            <span
              class={`flex items-center gap-2.5 rounded-lg px-3 py-1.5 text-[13px] ${
                item.active ? "bg-[#1c1f29] text-[#e8eaf0]" : "text-[#8b90a4]"
              }`}
            >
              <Fragment set:html={icon(item.glyph, `size-4 ${item.active ? "text-cyan-500" : ""}`)} />
              {item.label}
            </span>
          ))
        }
      </nav>
      <div class="mt-auto space-y-2.5 border-t border-[#262a37] p-3.5 text-[11px] text-[#8b90a4]">
        <div class="flex items-center gap-2">
          <span class="size-2 rounded-full bg-[#8b90a4]/50"></span>
          WoW is closed
        </div>
        <div class="flex items-center gap-2">
          <Fragment set:html={icon(Cloud, "size-3.5")} />
          Google Drive
        </div>
      </div>
    </aside>

    <div class="min-w-0 flex-1 space-y-4 p-4 sm:p-5">
      <header class="flex items-end justify-between gap-3">
        <div>
          <p class="text-lg font-semibold tracking-tight">Dashboard</p>
          <p class="text-[12px] text-[#8b90a4]">Keep your addon settings in sync across your PCs.</p>
        </div>
        <span class={`${button} border border-[#262a37] bg-[#1c1f29]`}>
          <Fragment set:html={icon(RefreshCw, "size-3.5")} /> Refresh
        </span>
      </header>

      <div class="grid gap-3 sm:grid-cols-2">
        {
          flavors.map((flavor) => (
            <div class="flex flex-col rounded-xl border border-[#262a37] bg-[#14161d]">
              <div class="flex items-start justify-between gap-2 p-3.5 pb-2">
                <div>
                  <p class="font-semibold">{flavor.name}</p>
                  <p class="mt-0.5 text-[12px] text-[#8b90a4]">{flavor.hint}</p>
                </div>
                <span
                  class={`inline-flex shrink-0 items-center gap-1 rounded-full border px-2 py-0.5 text-[11px] font-medium whitespace-nowrap ${flavor.badge.classes}`}
                >
                  <Fragment set:html={icon(flavor.badge.glyph, "size-3")} />
                  {flavor.badge.label}
                </span>
              </div>
              <div class="grid flex-1 grid-cols-2 gap-2 px-3.5 py-2">
                {[
                  { glyph: Monitor, label: "This PC", values: flavor.local },
                  { glyph: Cloud, label: "Cloud", values: flavor.cloud },
                ].map((stat) => (
                  <div class="rounded-lg border border-[#262a37] bg-[#0c0d12]/60 p-2.5">
                    <div class="flex items-center gap-1 text-[11px] text-[#8b90a4]">
                      <Fragment set:html={icon(stat.glyph, "size-3")} /> {stat.label}
                    </div>
                    <div class="mt-1 truncate text-[12px] font-medium">{stat.values[0]}</div>
                    <div class="text-[11px] text-[#8b90a4]">{stat.values[1]}</div>
                  </div>
                ))}
              </div>
              <div class="flex flex-wrap items-center gap-1.5 p-3.5 pt-2">
                <span
                  class={`${button} ${
                    flavor.pullHighlighted
                      ? "border border-cyan-500/50 text-cyan-500"
                      : "border border-[#262a37] bg-[#1c1f29]"
                  }`}
                >
                  <Fragment set:html={icon(ArrowDownToLine, "size-3.5")} /> Pull
                </span>
                <span class={`${button} border border-[#262a37] bg-[#1c1f29]`}>
                  <Fragment set:html={icon(ArrowUpFromLine, "size-3.5")} /> Push
                </span>
                <span class={`${button} text-[#8b90a4]`}>
                  <Fragment set:html={icon(ListTree, "size-3.5")} />
                </span>
                <span class={`${button} ml-auto bg-cyan-500 text-cyan-950`}>
                  <Fragment set:html={icon(Play, "size-3.5")} /> Launch
                </span>
              </div>
            </div>
          ))
        }
      </div>

      <div class="rounded-xl border border-[#262a37] bg-[#14161d] p-3.5">
        <p class="text-[13px] font-semibold">Recent activity</p>
        <ul class="mt-1 divide-y divide-[#262a37]">
          {
            activity.map((entry) => (
              <li class="flex items-center gap-2.5 py-2 text-[12px]">
                <Fragment set:html={icon(entry.glyph, "size-3.5 shrink-0 text-[#8b90a4]")} />
                <span class="flex-1 truncate">{entry.message}</span>
                <span class="hidden text-[11px] text-[#8b90a4] sm:inline">{entry.flavor}</span>
                <span class="w-24 text-right text-[11px] text-[#8b90a4]">{entry.time}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</figure>
